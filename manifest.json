{
  "manifest_version": 3,
  "name": "SEO Basic",
  "version": "2.1.0",
  "description": "SEO Basic PRO: audit SEO on-page với điểm số, hreflang, canonical, preview SERP/Social, export JSON/TXT/CSV.",
  "author": "Bin.Late",
  "homepage_url": "https://muabanquyen.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "scripting"],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "SEO Basic PRO"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["defaults.js", "score.js", "audit.js", "performance.js", "ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
